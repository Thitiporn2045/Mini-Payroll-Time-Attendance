<section class="detail-summary-row">
    <div class="summary-card detail-summary-card">
        <div class="summary-card-header">
        <div class="summary-icon-shell summary-icon-blue">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
            <path d="M3.75 8.25A2.25 2.25 0 0 1 6 6h12a2.25 2.25 0 0 1 2.25 2.25v7.5A2.25 2.25 0 0 1 18 18H6a2.25 2.25 0 0 1-2.25-2.25z"/>
            <path d="M15.75 12h.008v.008h-.008z"/>
            <path d="M7.5 9.75h3.75"/>
            <path d="M7.5 14.25h5.25"/>
            </svg>
        </div>

        <div class="summary-card-copy">
            <p class="summary-label">เงินเดือนพื้นฐาน</p>
            <p class="summary-value">
                <%= number_to_currency(payroll.base_salary, unit: "฿", precision: 0) %>
            </p>
        </div>
        </div>

        <div class="summary-card-footer">
        <p class="summary-month-label">
            <%= local_assigns[:selected_month_title] %>
        </p>
        </div>
    </div>

    <div class="summary-card detail-summary-card">
        <div class="summary-card-header">
        <div class="summary-icon-shell summary-icon-blue">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
            <rect x="3.75" y="5.25" width="16.5" height="15" rx="2.25"/>
            <path d="M8.25 3.75v3"/>
            <path d="M15.75 3.75v3"/>
            <path d="M3.75 9.75h16.5"/>
            </svg>
        </div>

        <div class="summary-card-copy">
            <p class="summary-label">วันทำงาน</p>
            <p class="summary-value">
                <%= payroll.working_days %>
                <span class="text-base font-semibold text-slate-400">วัน</span>
            </p>
        </div>
        </div>

        <div class="summary-card-footer">
        <p class="summary-month-label">
            เฉพาะเดือน <%= local_assigns[:selected_month_title] %>
        </p>
        </div>
    </div>

    <div class="summary-card detail-summary-card">
        <div class="summary-card-header">
        <div class="summary-icon-shell summary-icon-blue">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
            <circle cx="12" cy="12" r="8.25"/>
            <path d="M12 7.75v4.5l3 1.75"/>
            </svg>
        </div>

        <div class="summary-card-copy">
            <p class="summary-label">ชั่วโมง OT รวม</p>
            <p class="summary-value">
                <%= payroll.total_ot_hours %>
                <span class="text-base font-semibold text-slate-400">ชม.</span>
            </p>
        </div>
        </div>

        <div class="summary-card-footer">
        <p class="summary-month-label">
            เฉพาะเดือน <%= local_assigns[:selected_month_title] %>
        </p>
        </div>
    </div>

    <div class="summary-card detail-summary-card">
        <div class="summary-card-header">
        <div class="summary-icon-shell summary-icon-blue">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
            <circle cx="10.5" cy="13.5" r="5.75"/>
            <path d="M10.5 10.5v3l2.25 1.5"/>
            <path d="M17.25 6v5.25"/>
            <path d="M14.625 8.625h5.25"/>
            </svg>
        </div>

        <div class="summary-card-copy">
            <p class="summary-label">ค่าล่วงเวลา</p>
            <p class="summary-value">
                <%= number_to_currency(payroll.ot_pay, unit: "฿", precision: 0) %>
            </p>
        </div>
        </div>

        <div class="summary-card-footer">
        <p class="summary-month-label">
            คำนวณจากชั่วโมง OT
        </p>
        </div>
    </div>

    <div class="summary-card detail-summary-card">
        <div class="summary-card-header">
        <div class="summary-icon-shell summary-icon-blue">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
            <path d="M7.5 3.75h6.75l3.75 3.75v12a.75.75 0 0 1-.75.75h-9.75a.75.75 0 0 1-.75-.75V4.5a.75.75 0 0 1 .75-.75z"/>
            <path d="M14.25 3.75v3.75H18"/>
            <path d="M9 12h6"/>
            <path d="M9 15.75h6"/>
            </svg>
        </div>

        <div class="summary-card-copy">
            <p class="summary-label">ภาษี</p>
            <p class="summary-value">
                <%= number_to_currency(payroll.tax, unit: "฿", precision: 0) %>
            </p>
        </div>
        </div>

        <div class="summary-card-footer">
        <p class="summary-month-label">
            คำนวณจากเงินเดือนพื้นฐาน
        </p>
        </div>
    </div>

    <div class="summary-card detail-summary-card">
        <div class="summary-card-header">
        <div class="summary-icon-shell summary-icon-pink">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
            <rect x="3.75" y="6.75" width="16.5" height="10.5" rx="2.25"/>
            <circle cx="12" cy="12" r="2.25"/>
            <path d="M6.75 9.75h.008v.008H6.75z"/>
            <path d="M17.25 14.25h.008v.008h-.008z"/>
            </svg>
        </div>

        <div class="summary-card-copy">
            <p class="summary-label">รายได้สุทธิ</p>
            <p class="summary-value-accent">
                <%= number_to_currency(payroll.net_pay, unit: "฿", precision: 0) %>
            </p>
        </div>
        </div>

        <div class="summary-card-footer">
        <p class="summary-month-label">
            เงินเดือน + OT - ภาษี
        </p>
        </div>
    </div>
</section>
