<header class="mb-8">
    <div class="page-header">
        <div class="max-w-2xl">
        <h1 class="page-title">
            รายละเอียดพนักงาน
        </h1>
        </div>

        <div class="w-full flex justify-center items-center gap-4 max-w-xs lg:w-80">
        <label for="employee_selector" class="label-text pt-2 w-24">
            เลือกคนอื่น
        </label>

        <div class="dropdown-shell">
            <%= select_tag :employee_selector,
            options_from_collection_for_select(employees_for_select, :id, :name, employee.id),
            onchange: "const month = this.dataset.monthValue; const status = this.dataset.statusValue; const params = new URLSearchParams(); if (month) params.set('month', month); if (status) params.set('status', status); const query = params.toString(); const url = '/employees/' + this.value + (query ? '?' + query : ''); window.Turbo ? Turbo.visit(url) : window.location.href = url",
            data: {
              month_value: local_assigns[:selected_month_value],
              status_value: local_assigns[:attendance_status_filter]
            },
            class: "dropdown-native" %>
            <span class="dropdown-icon">▼</span>
        </div>
        </div>
    </div>

    <section class="section-card mt-8 px-5 py-6 sm:px-7 lg:px-8">
        <div class="flex flex-col gap-6 xl:flex-row xl:items-center xl:justify-between">
        <div class="flex min-w-0 flex-col gap-5 sm:flex-row sm:items-center">
            <div class="grid h-24 w-24 shrink-0 place-items-center rounded-full bg-slate-950 text-4xl font-black text-white">
            <%= initials %>
            </div>

            <div class="min-w-0">
            <h2 class="truncate text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
                <%= employee.name %>
            </h2>

            <div class="mt-3 flex flex-wrap items-center gap-3">
                <span class="chip-neutral px-4 py-1.5 text-xs sm:text-sm">
                รหัส EMP-<%= employee.id.to_s.rjust(3, "0") %>
                </span>

                <span class="chip-blue px-4 py-1.5 text-sm">
                <%= employee.position.name %>
                </span>
            </div>

            <p class="mt-4 text-sm font-semibold text-slate-500">
                เงินเดือน
                <span class="ml-2 font-mono text-xl font-black text-slate-900 sm:text-2xl">
                <%= number_to_currency(employee.salary, unit: "฿", precision: 0) %>
                </span>
            </p>
            </div>
        </div>

        <div class="flex w-full flex-col gap-8 xl:max-w-xl xl:items-end">
            <%= form_with url: employee_path(employee),
            method: :get,
            class: "w-full xl:flex xl:justify-end",
            data: { controller: "filter-form" } do %>
            <%= hidden_field_tag :status, local_assigns[:attendance_status_filter] if local_assigns[:attendance_status_filter].present? %>

            <label class="month-filter-shell">
                <span class="month-filter-label">เดือนที่ใช้คำนวณ</span>

                <%= month_field_tag :month,
                local_assigns[:selected_month_value],
                class: "month-filter-input",
                data: { action: "change->filter-form#submitNow" } %>
            </label>
            <% end %>

            <div class="grid w-full gap-3 sm:grid-cols-3">
            <%= button_to "ลบ",
                employee_path(employee, return_to: "employee_show"),
                method: :delete,
                form: {
                data: {
                    turbo_confirm: "ต้องการลบพนักงานคนนี้ใช่ไหม? ข้อมูลเวลาเข้าออกงานทั้งหมดจะถูกลบตาม",
                    turbo_frame: "_top"
                },
                class: "w-full"
                },
                class: "btn-danger w-full" %>

            <%= link_to "แก้ไขข้อมูลพนักงาน",
                edit_employee_path(employee, return_to: "employee", month: local_assigns[:selected_month_value], status: local_assigns[:attendance_status_filter]),
                data: { turbo_frame: "employee_form_panel" },
                class: "btn-secondary w-full" %>

            <%= link_to "เพิ่มเวลาเข้าออกงาน",
                new_employee_attendance_path(
                    employee,
                    month: local_assigns[:selected_month_value],
                    status: local_assigns[:attendance_status_filter]
                ),
                data: { turbo_frame: "attendance_form_panel" },
                class: "btn-primary w-full" %>
            </div>
        </div>
        </div>
    </section>
</header>
