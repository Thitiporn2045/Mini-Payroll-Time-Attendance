<%= form_with model: employee, class: "space-y-5" do |form| %>
    <% return_path = employee_form_return_path(employee) %>

    <% if params[:return_to].present? %>
        <%= hidden_field_tag :return_to, params[:return_to] %>
    <% end %>

    <%= hidden_field_tag :employee_query, params[:employee_query] if params[:employee_query].present? %>
    <%= hidden_field_tag :position, params[:position] if params[:position].present? %>

    <% if employee.errors.any? %>
        <div class="error-box">
            <p class="error-title">กรุณาตรวจสอบข้อมูลต่อไปนี้</p>

            <ul class="mt-2 list-disc pl-5">
            <% employee.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
            </ul>
        </div>
    <% end %>

    <div>
        <%= form.label :name, "ชื่อ-นามสกุล", class: "label-text" %>

        <%= form.text_field :name,
        class: "input-field",
        placeholder: "เช่น สมชาย ใจดี" %>
    </div>

    <div>
    <div class="mb-2 flex flex-wrap items-center gap-2">
        <%= form.label :position_name, "ตำแหน่ง", class: "label-text mb-0" %>

        <span class="text-xs font-medium text-orange-400">
        เลือกจากรายการ หรือพิมพ์ชื่อตำแหน่งใหม่ได้เลย
        </span>
    </div>

    <div class="combobox" data-controller="position-combobox">
        <%= form.text_field :position_name,
        value: employee.position_name.presence || employee.position&.name,
        class: "input-field pr-12",
        autocomplete: "off",
        placeholder: "เลือกหรือพิมพ์ตำแหน่งใหม่ เช่น นักพัฒนา",
        data: {
            position_combobox_target: "input",
            action: "focus->position-combobox#open input->position-combobox#filter keydown->position-combobox#handleKeydown"
        } %>

        <button
        type="button"
        class="absolute inset-y-0 right-0 inline-flex w-12 cursor-pointer items-center justify-center text-slate-500"
        aria-label="เปิดรายการตำแหน่ง"
        aria-expanded="false"
        data-position-combobox-target="button"
        data-action="click->position-combobox#toggle">
        ▼
        </button>

        <%= render "position_options_frame", positions: positions %>
    </div>
    </div>

    <div>
        <%= form.label :salary, "เงินเดือน", class: "label-text" %>

        <%= form.number_field :salary,
        min: 1,
        step: 0.01,
        class: "input-field",
        placeholder: "54000" %>
    </div>

    <div class="flex justify-end gap-3">
        <%= link_to "ยกเลิก",
        return_path,
        data: { turbo_frame: "_top", action: "click->side-panel#linkClose" },
        class: "btn-secondary" %>

        <%= form.submit employee.persisted? ? "บันทึกการแก้ไข" : "บันทึกข้อมูล",
            class: "btn-primary" %>
    </div>
<% end %>
