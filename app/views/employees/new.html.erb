<%= turbo_frame_tag "employee_form_panel" do %>
    <% return_path = employee_form_return_path %>

    <div
        class="modal-backdrop"
        data-controller="side-panel"
        data-side-panel-open-value="<%= @employee.errors.any? %>"
        data-side-panel-close-url-value="<%= return_path %>"
        data-action="click->side-panel#backdropClicked">
        <div class="modal-panel max-w-md" data-side-panel-target="panel">
        <div class="modal-header">
            <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="modal-title">เพิ่มพนักงาน</h2>
                <p class="modal-subtitle">
                กรอกข้อมูลพนักงานใหม่ และเลือกหรือพิมพ์ตำแหน่งใหม่ได้
                </p>
            </div>

            <%= link_to "×",
                return_path,
                data: { turbo_frame: "_top", action: "click->side-panel#linkClose" },
                class: "icon-button" %>
            </div>
        </div>

        <div class="px-6 py-5">
            <%= render "form", employee: @employee, positions: @positions %>
        </div>

        </div>
    </div>
<% end %>
