<%= turbo_frame_tag "attendance_form_panel" do %>
    <% return_path = employee_path(@employee, month: params[:month], status: params[:status]) %>

    <div
        class="modal-backdrop"
        data-controller="side-panel"
        data-side-panel-open-value="<%= @attendance.errors.any? %>"
        data-side-panel-close-url-value="<%= return_path %>"
        data-action="click->side-panel#backdropClicked">
        <div class="modal-panel max-w-lg" data-side-panel-target="panel">
        <div class="modal-header">
            <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="modal-title">แก้ไขข้อมูลเวลาเข้าออกงาน</h2>
                <p class="modal-subtitle">
                ปรับวันที่ทำงาน สถานะ หรือเวลาเข้าออกงานของ <%= @employee.name %>
                </p>
            </div>

            <%= link_to "×",
                return_path,
                data: { turbo_frame: "_top", action: "click->side-panel#linkClose" },
                class: "icon-button" %>
            </div>
        </div>

        <div class="px-6 py-5">
            <%= render "form",
            employee: @employee,
            attendance: @attendance %>
        </div>
        </div>
    </div>
<% end %>