<% if params[:return_to] == "workspace" %>
    <%= turbo_stream.update "attendance_workspace_table" do %>
        <%= render "attendances/workspace_table",
        attendances: @attendance_records,
        employee_query: @employee_query,
        status_filter: @status_filter %>
    <% end %>

    <%= turbo_stream.update "attendance_form_panel" do %>
        <%= render template: "attendances/new" %>
    <% end %>
    <% else %>
    <%= turbo_stream.update "attendance_table" do %>
        <%= render "employees/attendance_table",
            employee: @employee,
            attendances: @attendances,
            selected_month_title: @selected_month_title,
            selected_month_value: @selected_month_value,
            selected_month_label: @selected_month_label,
            status_filter: @attendance_status_filter %>
        <% end %>

    <%= turbo_stream.update "payroll_summary_header" do %>
    <%= render "employees/payroll_summary_header",
        employee: @employee,
        selected_month_value: @selected_month_value,
        selected_month_title: @selected_month_title,
        attendance_status_filter: @attendance_status_filter %>
    <% end %>

    <%= turbo_stream.update "payroll_summary" do %>
    <%= render "employees/payroll_summary",
        payroll: @payroll,
        selected_month_title: @selected_month_title %>
    <% end %>

    <%= turbo_stream.update "payroll_recipe" do %>
        <%= render "employees/payroll_sidebar",
            payroll: @payroll,
            selected_month_label: @selected_month_label %>
    <% end %>

    <%= turbo_stream.update "attendance_form_panel", "" %>
    <% end %>

    <%= turbo_stream.update "flash" do %>
    <%= render "shared/flash", notice: "เพิ่มข้อมูลเวลาเข้าออกงานเรียบร้อยแล้ว" %>
<% end %>
