<div class="page-shell">
    <div id="flash">
        <%= render "shared/flash" %>
    </div>

    <div class="workspace-shell">
        <%= render "shared/workspace_sidebar", active: :attendances %>

        <div class="workspace-content-index">
        <div class="page-header">
            <div>
            <h1 class="page-title">ข้อมูลเวลาเข้าออกงาน</h1>
            <p class="page-subtitle">
                บันทึกเวลาเข้าออกงานของพนักงานทุกคน
            </p>
            </div>

            <%= link_to "เพิ่มเวลาเข้าออกงาน",
            new_attendance_path(return_to: "workspace", employee_query: @employee_query, status: @status_filter),
            data: { turbo_frame: "attendance_form_panel" },
            class: "btn-primary" %>
        </div>

        <div id="attendance_workspace_table" class="flex min-h-0 flex-1 flex-col overflow-hidden">
            <%= render "workspace_table",
            attendances: @attendance_records,
            employee_query: @employee_query,
            status_filter: @status_filter %>
        </div>
        </div>
    </div>

    <%= turbo_frame_tag "attendance_form_panel" %>
</div>
