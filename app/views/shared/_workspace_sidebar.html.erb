<aside class="workspace-sidebar">
    <p class="text-xs font-bold uppercase tracking-[0.28em] text-pink-200">
        Mini Payroll
    </p>

    <h1 class="mt-8 text-4xl font-bold tracking-tight">Workspace</h1>

    <div class="mt-6">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-slate-400">
        Navigate
        </p>

        <div class="workspace-nav">
        <%= link_to employees_path, class: active == :employees ? "workspace-nav-item-active" : "workspace-nav-item-inactive" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="workspace-nav-icon" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M3.75 9.75 12 3l8.25 6.75"/>
                <path d="M5.25 8.75v10.5a1.5 1.5 0 0 0 1.5 1.5h10.5a1.5 1.5 0 0 0 1.5-1.5V8.75"/>
                <path d="M9.75 20.75v-6h4.5v6"/>
            </svg>
            <span>พนักงาน</span>
        <% end %>

        <%= link_to attendances_path,
            class: active == :attendances ? "workspace-nav-item-active" : "workspace-nav-item-inactive" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="workspace-nav-icon" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <rect x="3.75" y="5.25" width="16.5" height="15" rx="2.25"/>
                <path d="M8.25 3.75v3"/>
                <path d="M15.75 3.75v3"/>
                <path d="M3.75 9.75h16.5"/>
                <path d="m8.25 13.5 2.25 2.25 5.25-5.25"/>
            </svg>
            <span>เวลาเข้าออกงาน</span>
        <% end %>
        </div>
    </div>
</aside>
