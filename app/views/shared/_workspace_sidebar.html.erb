    </p>

    <h1 class="mt-8 text-4xl font-bold tracking-tight">Workspace</h1>

    <div class="mt-6">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-slate-400">
        Navigate
        </p>

        <div class="workspace-nav">
        <%= link_to employees_path, class: active == :employees ? "workspace-nav-item-active" : "workspace-nav-item-inactive" do %>
